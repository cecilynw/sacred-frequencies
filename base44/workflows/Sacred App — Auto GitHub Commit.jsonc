      "dsl": "1.0.0",
      "name": "sacred_app_auto_github_commit",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_agent_step": {
          "call": "invoke_superagent_step",
          "with": {
